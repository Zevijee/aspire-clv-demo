# Docker-only configuration. Copy to .env.docker; the repository root .env, which
# points at your local database, is never read by Compose and stays unchanged.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build

# Port the demo is published on, bound to localhost only.
APP_PORT=5173

POSTGRES_DB=aspire_analytics
POSTGRES_USER=aspire
# Choose a password before the first start. It is passed as a structured connection
# field, so punctuation needs no URL encoding. Quote a literal $ with single quotes.
POSTGRES_PASSWORD=aspire-local-demo

# Report-local today, used for date ranges and the data-status endpoint.
REPORTING_TIMEZONE=America/New_York
