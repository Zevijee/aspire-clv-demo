# Docker-only local demo configuration. Copy to .env.docker; keep the root .env unchanged.
APP_PORT=5173
POSTGRES_DB=aspire_analytics
POSTGRES_USER=aspire
# Choose a local password before first startup. It is passed as a structured
# connection field; punctuation does not need URL encoding. Quote literal $ as needed
# using Compose's single-quoted .env values, e.g. POSTGRES_PASSWORD='your$password'.
POSTGRES_PASSWORD=aspire-local-demo
APP_ENVIRONMENT=development
DOCKER_DEMO_INSTANCE_ID=aspire-docker
REPORTING_TIMEZONE=America/New_York
# Polling handles bind mounts whose filesystem events do not reach containers.
# Set false on a native Linux filesystem when normal file watching works.
DEV_WATCH_POLLING=true

# Only for compose.external-db.yaml. Use the existing database's real credentials.
# Use host.docker.internal for a database on the Docker host, or a reachable DNS
# name for a remote database. The override defines the host alias on Linux too.
# This URL uses URL-encoded credentials, just like the existing root DATABASE_URL.
# EXTERNAL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@host.docker.internal:5432/DATABASE
# Optional custom host route; normally keep Docker's host-gateway default.
# DOCKER_HOST_GATEWAY=host-gateway
