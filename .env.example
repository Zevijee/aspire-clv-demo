# Optional native workflow only. The default Docker setup uses .env.docker.example
# and runs PostgreSQL as part of the stack; no separate installation is required.
# PostgreSQL connection used by the native Aspire API and data seeders.
# URL-encode special characters in the password.
# DATABASE_URL=postgresql+psycopg://postgres:pglocal@localhost:5432/aspire_analytics

# A comma-separated list of browser origins permitted to call the local API.
CORS_ORIGINS=http://localhost:5173

# Reporting dates use this explicit timezone, including on Windows.
REPORTING_TIMEZONE=America/New_York

# Fake generation additionally requires a matching database target identity.
# Set DEMO_INSTANCE_ID locally, then explicitly configure that identity with
# python -m data.migrations configure-demo --instance-id YOUR_LOCAL_ID
ENVIRONMENT=development
DEMO_INSTANCE_ID=

