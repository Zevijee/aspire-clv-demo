*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
*.log
*.log.*
/output/

# Schema drafting is local working state until update publishes it. The published
# schema, migrations and backfills are committed from their active locations.
/shared/database/staged/
/shared/database/stage-history/
/shared/database/.staging.lock

